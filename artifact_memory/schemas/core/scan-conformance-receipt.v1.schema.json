{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/scan-conformance-receipt/v1",
  "title": "Artifact Memory scan conformance receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_id", "outcome", "synthetic", "case_count", "outcomes", "cases", "claims", "limitations"],
  "properties": {
    "schema_id": {"const": "artifact-memory/scan-conformance-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^scan-conformance-receipt://[0-9a-f]{64}$"},
    "outcome": {"const": "complete"},
    "synthetic": {"const": true},
    "case_count": {"type": "integer", "minimum": 1},
    "outcomes": {"type": "object", "additionalProperties": false, "required": ["complete", "partial", "failed", "cancelled"], "properties": {"complete": {"type": "integer", "minimum": 1}, "partial": {"type": "integer", "minimum": 1}, "failed": {"type": "integer", "minimum": 1}, "cancelled": {"type": "integer", "minimum": 1}}},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "outcome", "manifest_ref", "manifest_tree_digest", "receipt_ref", "warning_codes", "failure_codes", "excluded_entry_count"], "properties": {"id": {"type": "string", "minLength": 1}, "outcome": {"enum": ["complete", "partial", "failed", "cancelled"]}, "manifest_ref": {"type": "string", "pattern": "^manifest://[0-9a-f]{64}$"}, "manifest_tree_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"}, "receipt_ref": {"type": "string", "pattern": "^scan-receipt://sha-256/[0-9a-f]{64}$"}, "warning_codes": {"type": "array", "items": {"type": "string", "minLength": 1}}, "failure_codes": {"type": "array", "items": {"type": "string", "minLength": 1}}, "excluded_entry_count": {"type": "integer", "minimum": 0}}}},
    "claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

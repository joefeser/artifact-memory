{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/platform-matrix-receipt/v2",
  "title": "Artifact Memory platform matrix receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "profile", "runtime", "observations", "diagnostics", "limitations"],
  "properties": {
    "schema_id": {"const": "artifact-memory/platform-matrix-receipt/v2"},
    "profile": {"const": "v0-case-sensitive-unicode-codepoint"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "python"],
      "properties": {
        "family": {"enum": ["darwin", "linux", "windows"]},
        "python": {"type": "string"}
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_sensitivity", "unicode_name_behavior", "symlink_behavior", "repo_identity_redirect_behavior", "timestamps", "mount_layout"],
      "properties": {
        "case_sensitivity": {"enum": [true, false, null]},
        "unicode_name_behavior": {"type": "string"},
        "symlink_behavior": {"type": "string"},
        "repo_identity_redirect_behavior": {
          "enum": ["not-applicable", "junction-rejected", "fixture-creation-failed", "junction-creation-failed", "unexpected-diagnostic", "junction-followed", "probe-failed"]
        },
        "timestamps": {"const": "ignored-by-v0-profile"},
        "mount_layout": {"const": "logical-relative-paths-only"}
      }
    },
    "diagnostics": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}

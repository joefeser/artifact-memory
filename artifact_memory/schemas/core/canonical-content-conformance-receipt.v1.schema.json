{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/canonical-content-conformance-receipt/v1",
  "title": "Artifact Memory canonical and content conformance receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_id", "outcome", "synthetic", "canonical_vector_count", "invalid_vector_count", "revision_example_count", "zero_byte_outcome", "large_object_outcome", "large_object_byte_size", "verification_outcomes", "vector_set_digest", "identity_boundaries", "limitations"],
  "properties": {
    "schema_id": {"const": "artifact-memory/canonical-content-conformance-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^canonical-content-receipt://[0-9a-f]{64}$"},
    "outcome": {"const": "complete"},
    "synthetic": {"const": true},
    "canonical_vector_count": {"type": "integer", "minimum": 1},
    "invalid_vector_count": {"type": "integer", "minimum": 1},
    "revision_example_count": {"type": "integer", "minimum": 1},
    "zero_byte_outcome": {"const": "verified"},
    "large_object_outcome": {"const": "verified"},
    "large_object_byte_size": {"type": "integer", "minimum": 1},
    "verification_outcomes": {"type": "object", "additionalProperties": false, "required": ["verified", "mismatch", "unreadable", "unsupported"], "properties": {"verified": {"type": "integer", "minimum": 1}, "mismatch": {"type": "integer", "minimum": 1}, "unreadable": {"type": "integer", "minimum": 1}, "unsupported": {"type": "integer", "minimum": 1}}},
    "vector_set_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "identity_boundaries": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

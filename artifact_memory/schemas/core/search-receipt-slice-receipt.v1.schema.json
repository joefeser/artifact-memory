{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/search-receipt-slice-receipt/v1",
  "title": "Artifact Memory digest-bearing search receipt synthetic slice receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_id", "outcome", "operations", "projection", "search_receipt", "authority_boundary", "limitations"],
  "properties": {
    "schema_id": {"const": "artifact-memory/search-receipt-slice-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^search-receipt-slice-receipt://synthetic/[0-9a-f]{64}$"},
    "outcome": {"type": "string", "enum": ["complete", "failed"]},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "outcome"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "enum": ["complete", "verified", "failed"]}
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_record_set_digest", "record_count"],
      "properties": {
        "source_record_set_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
        "record_count": {"type": "integer", "minimum": 0}
      }
    },
    "search_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "record_ids", "integrity_gate", "digest_matches_projection", "matches_raw_search", "cli_json_receipt_equals_library_receipt", "cli_human_receipt_names_digest"],
      "properties": {
        "query": {"type": "string", "minLength": 1},
        "record_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "integrity_gate": {"const": "verified"},
        "digest_matches_projection": {"const": true},
        "matches_raw_search": {"const": true},
        "cli_json_receipt_equals_library_receipt": {"const": true},
        "cli_human_receipt_names_digest": {"const": true}
      }
    },
    "authority_boundary": {"const": "informational-only/no-execution-authority"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

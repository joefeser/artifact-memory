{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/content-verification-receipt/v1",
  "title": "Artifact Memory content verification receipt v1",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {"if": {"required": ["outcome"], "properties": {"outcome": {"enum": ["verified", "mismatch"]}}}, "then": {"required": ["observed_byte_size"]}},
    {"if": {"required": ["outcome"], "properties": {"outcome": {"enum": ["unreadable", "unsupported"]}}}, "then": {"not": {"required": ["observed_byte_size"]}}}
  ],
  "required": ["schema_id", "receipt_id", "outcome", "content_ref", "expected_byte_size", "digest_results", "diagnostics", "authority_boundary"],
  "properties": {
    "schema_id": {"const": "artifact-memory/content-verification-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^content-verification-receipt://[0-9a-f]{64}$"},
    "outcome": {"enum": ["verified", "mismatch", "unreadable", "unsupported"]},
    "content_ref": {"type": "string", "pattern": "^content://[A-Za-z0-9._~-]+/[A-Za-z0-9._~/-]+$"},
    "expected_byte_size": {"type": "integer", "minimum": 0},
    "observed_byte_size": {"type": "integer", "minimum": 0},
    "digest_results": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["algorithm", "expected", "outcome"], "allOf": [{"if": {"required": ["outcome"], "properties": {"outcome": {"enum": ["verified", "mismatch"]}}}, "then": {"required": ["observed"]}}, {"if": {"required": ["outcome"], "properties": {"outcome": {"enum": ["unsupported", "not-checked"]}}}, "then": {"not": {"required": ["observed"]}}}], "properties": {"algorithm": {"type": "string", "minLength": 1}, "expected": {"type": "string", "minLength": 1}, "observed": {"type": "string", "minLength": 1}, "outcome": {"enum": ["verified", "mismatch", "unsupported", "not-checked"]}}}},
    "diagnostics": {"type": "array", "items": {"enum": ["byte-size-mismatch", "digest-mismatch", "content-unreadable", "digest-algorithm-unsupported"]}},
    "authority_boundary": {"const": "content verification grants no execution, disclosure, mutation, or trust authority"}
  }
}

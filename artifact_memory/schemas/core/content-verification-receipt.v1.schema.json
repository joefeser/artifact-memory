{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/content-verification-receipt/v1",
  "title": "Artifact Memory content verification receipt v1",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {"if": {"required": ["outcome"], "properties": {"outcome": {"const": "verified"}}}, "then": {"required": ["observed_byte_size"], "properties": {"digest_results": {"type": "array", "items": {"type": "object", "properties": {"outcome": {"const": "verified"}}}}, "diagnostics": {"const": []}}}},
    {"if": {"required": ["outcome"], "properties": {"outcome": {"const": "mismatch"}}}, "then": {"required": ["observed_byte_size"], "properties": {"digest_results": {"type": "array", "items": {"type": "object", "properties": {"outcome": {"enum": ["verified", "mismatch"]}}}}, "diagnostics": {"type": "array", "minItems": 1}}}},
    {"if": {"required": ["outcome"], "properties": {"outcome": {"const": "unreadable"}}}, "then": {"not": {"required": ["observed_byte_size"]}, "properties": {"digest_results": {"type": "array", "items": {"type": "object", "properties": {"outcome": {"const": "not-checked"}}}}, "diagnostics": {"const": ["content-unreadable"]}}}},
    {"if": {"required": ["outcome"], "properties": {"outcome": {"const": "unsupported"}}}, "then": {"not": {"required": ["observed_byte_size"]}, "properties": {"digest_results": {"type": "array", "items": {"type": "object", "properties": {"outcome": {"enum": ["unsupported", "not-checked"]}}}}, "diagnostics": {"const": ["digest-algorithm-unsupported"]}}}}
  ],
  "required": ["schema_id", "receipt_id", "outcome", "content_ref", "expected_byte_size", "digest_results", "diagnostics", "authority_boundary"],
  "properties": {
    "schema_id": {"const": "artifact-memory/content-verification-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^content-verification-receipt://[0-9a-f]{64}$"},
    "outcome": {"enum": ["verified", "mismatch", "unreadable", "unsupported"]},
    "content_ref": {"type": "string", "pattern": "^content://sha-256/[0-9a-f]{64}$"},
    "expected_byte_size": {"type": "integer", "minimum": 0},
    "observed_byte_size": {"type": "integer", "minimum": 0},
    "digest_results": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["algorithm", "expected", "outcome"], "allOf": [{"if": {"required": ["outcome"], "properties": {"outcome": {"enum": ["verified", "mismatch"]}}}, "then": {"required": ["observed"]}}, {"if": {"required": ["outcome"], "properties": {"outcome": {"enum": ["unsupported", "not-checked"]}}}, "then": {"not": {"required": ["observed"]}}}, {"if": {"required": ["algorithm"], "properties": {"algorithm": {"const": "sha-256"}}}, "then": {"properties": {"expected": {"pattern": "^sha-256:[0-9a-f]{64}$"}, "observed": {"pattern": "^sha-256:[0-9a-f]{64}$"}}}}, {"if": {"required": ["algorithm"], "properties": {"algorithm": {"const": "sha-512"}}}, "then": {"properties": {"expected": {"pattern": "^sha-512:[0-9a-f]{128}$"}, "observed": {"pattern": "^sha-512:[0-9a-f]{128}$"}}}}], "properties": {"algorithm": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}, "expected": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*:[0-9a-f]+$"}, "observed": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*:[0-9a-f]+$"}, "outcome": {"enum": ["verified", "mismatch", "unsupported", "not-checked"]}}}},
    "diagnostics": {"type": "array", "items": {"enum": ["byte-size-mismatch", "digest-mismatch", "content-unreadable", "digest-algorithm-unsupported"]}},
    "authority_boundary": {"const": "content verification grants no execution, disclosure, mutation, or trust authority"}
  }
}

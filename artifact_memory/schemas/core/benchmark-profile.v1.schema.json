{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/benchmark-profile/v1",
  "title": "Artifact Memory synthetic benchmark profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "profile_id", "file_count", "small_file_size_bytes", "large_file_size_bytes", "depth", "projection_record_count", "scan_byte_limit", "scan_entry_limit", "archive_max_entries", "archive_max_uncompressed_bytes", "nested_archive_depth"],
  "properties": {
    "schema_id": {"const": "artifact-memory/benchmark-profile/v1"},
    "profile_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "file_count": {"type": "integer", "minimum": 1},
    "small_file_size_bytes": {"type": "integer", "minimum": 1},
    "large_file_size_bytes": {"type": "integer", "minimum": 1},
    "depth": {"type": "integer", "minimum": 1},
    "projection_record_count": {"type": "integer", "minimum": 1},
    "scan_byte_limit": {"type": "integer", "minimum": 1},
    "scan_entry_limit": {"type": "integer", "minimum": 1},
    "archive_max_entries": {"type": "integer", "minimum": 1},
    "archive_max_uncompressed_bytes": {"type": "integer", "minimum": 1},
    "nested_archive_depth": {"type": "integer", "minimum": 1}
  }
}

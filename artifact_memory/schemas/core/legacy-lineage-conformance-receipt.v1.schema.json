{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/legacy-lineage-conformance-receipt/v1",
  "title": "Artifact Memory legacy lineage conformance receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_id", "outcome", "synthetic", "source_ref", "source_commit", "observation_count", "hash_states", "artifact_identities_established", "content_identities_established", "source_mutations", "vector_set_digest", "claims", "limitations"],
  "properties": {
    "schema_id": {"const": "artifact-memory/legacy-lineage-conformance-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^legacy-lineage-conformance-receipt://[0-9a-f]{64}$"},
    "outcome": {"const": "pass"},
    "synthetic": {"const": true},
    "source_ref": {"const": "https://github.com/joefeser/WhereAreMyFiles"},
    "source_commit": {"const": "3a18550fa52526e1a440a1e9264bd9f17638d89e"},
    "observation_count": {"const": 2},
    "hash_states": {"const": ["none-recorded", "sha-1-observed-not-upgraded"]},
    "artifact_identities_established": {"const": 0},
    "content_identities_established": {"const": 0},
    "source_mutations": {"const": 0},
    "vector_set_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

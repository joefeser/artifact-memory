{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/projection-integrity-slice-receipt/v1",
  "title": "Artifact Memory projection integrity synthetic slice receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_id", "outcome", "operations", "projection", "integrity_gate", "authority_boundary", "limitations"],
  "properties": {
    "schema_id": {"const": "artifact-memory/projection-integrity-slice-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^projection-integrity-receipt://synthetic/[0-9a-f]{64}$"},
    "outcome": {"type": "string", "enum": ["complete", "failed"]},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "outcome"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "enum": ["complete", "verified", "failed"]}
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_record_set_digest", "record_count", "clean_term_record_ids", "forged_term_clean_record_ids", "clean_metadata_digest_matches"],
      "properties": {
        "source_record_set_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
        "record_count": {"type": "integer", "minimum": 0},
        "clean_term_record_ids": {"type": "array", "items": {"type": "string"}},
        "forged_term_clean_record_ids": {"const": []},
        "clean_metadata_digest_matches": {"const": true}
      }
    },
    "integrity_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tamper_sequence", "forged_term", "gated_surface_outcomes", "clean_control_record_ids"],
      "properties": {
        "tamper_sequence": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "forged_term": {"type": "string", "minLength": 1},
        "gated_surface_outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["search", "related", "provenance", "metadata", "logical-snapshot"],
          "properties": {
            "search": {"const": "projection-unavailable"},
            "related": {"const": "projection-unavailable"},
            "provenance": {"const": "projection-unavailable"},
            "metadata": {"const": "projection-unavailable"},
            "logical-snapshot": {"const": "projection-unavailable"}
          }
        },
        "clean_control_record_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "authority_boundary": {"const": "informational-only/no-execution-authority"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

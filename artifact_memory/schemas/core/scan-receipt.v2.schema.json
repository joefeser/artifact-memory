{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/scan-receipt/v2",
  "title": "Artifact Memory scan receipt v2",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {"if": {"required": ["outcome"], "properties": {"outcome": {"const": "complete"}}}, "then": {"properties": {"warnings": {"const": []}, "failures": {"const": []}}}},
    {"if": {"required": ["outcome"], "properties": {"outcome": {"const": "partial"}}}, "then": {"anyOf": [{"properties": {"warnings": {"type": "array", "minItems": 1}}}, {"properties": {"failures": {"type": "array", "minItems": 1}}}]}},
    {"if": {"required": ["outcome"], "properties": {"outcome": {"const": "failed"}}}, "then": {"properties": {"failures": {"type": "array", "minItems": 1}}}},
    {"if": {"required": ["outcome"], "properties": {"outcome": {"const": "cancelled"}}}, "then": {"properties": {"warnings": {"type": "array", "minItems": 1}}}}
  ],
  "required": ["schema_id", "receipt_id", "attempt_id", "policy_ref", "policy_digest", "scope", "started_at", "ended_at", "implementation", "attempt_limits", "manifest_ref", "manifest_tree_digest", "outcome", "accounted_entry_count", "excluded_entry_count", "exclusions", "warnings", "failures", "diagnostics", "authority_boundary"],
  "properties": {
    "schema_id": {"const": "artifact-memory/scan-receipt/v2"},
    "receipt_id": {"type": "string", "pattern": "^scan-receipt://sha-256/[0-9a-f]{64}$"},
    "attempt_id": {"type": "string", "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "policy_ref": {"type": "string", "pattern": "^scan-policy://sha-256/[0-9a-f]{64}$"},
    "policy_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "scope": {"type": "object", "additionalProperties": false, "required": ["endpoint_ref", "root_relative_path"], "properties": {"endpoint_ref": {"type": "string", "pattern": "^endpoint://[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)?$"}, "root_relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\r\\n]*$"}}},
    "started_at": {"type": "string", "format": "date-time"},
    "ended_at": {"type": "string", "format": "date-time"},
    "implementation": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "attempt_limits": {"type": "object", "additionalProperties": false, "required": ["cancellation_enabled"], "properties": {"max_entries": {"type": "integer", "minimum": 0}, "max_bytes": {"type": "integer", "minimum": 0}, "cancellation_enabled": {"type": "boolean"}}},
    "manifest_ref": {"type": "string", "pattern": "^manifest://[0-9a-f]{64}$"},
    "manifest_tree_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "outcome": {"enum": ["complete", "partial", "failed", "cancelled"]},
    "accounted_entry_count": {"type": "integer", "minimum": 0},
    "excluded_entry_count": {"type": "integer", "minimum": 0},
    "exclusions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["relative_path", "rule"], "properties": {"relative_path": {"type": "string", "minLength": 1}, "rule": {"type": "string", "pattern": "^prefix:.+$"}}}},
    "warnings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"enum": ["collision", "resource-limit", "cancelled"]}, "message": {"type": "string", "minLength": 1}, "relative_path": {"type": "string", "minLength": 1}}}},
    "failures": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"enum": ["unreadable", "unsupported", "resolver-unavailable", "unstable"]}, "message": {"type": "string", "minLength": 1}, "relative_path": {"type": "string", "minLength": 1}}}},
    "diagnostics": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"enum": ["unreadable", "excluded", "unsupported", "collision", "resolver-unavailable", "resource-limit", "cancelled", "unstable"]}, "message": {"type": "string", "minLength": 1}, "relative_path": {"type": "string", "minLength": 1}}}},
    "authority_boundary": {"const": "filesystem observation grants no execution, disclosure, mutation, authenticity, trust, or authorization"},
    "extensions": {"type": "object", "additionalProperties": true}
  }
}

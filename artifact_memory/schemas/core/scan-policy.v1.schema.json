{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/scan-policy/v1",
  "title": "Artifact Memory scan policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "policy_id", "endpoint_ref", "root_relative_path", "follow_symlinks"],
  "properties": {
    "schema_id": {"const": "artifact-memory/scan-policy/v1"},
    "policy_id": {"type": "string", "pattern": "^scan-policy://[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+$"},
    "endpoint_ref": {"type": "string", "pattern": "^endpoint://[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)?$"},
    "root_relative_path": {"type": "string", "pattern": "^(?!/)(?!(?:.*/)?(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*|/|$))(?!.*//)(?!.*[. ](?:/|$))(?!.*[\\u0000-\\u001F\\u007F])[A-Za-z0-9._~/-]*$"},
    "follow_symlinks": {"type": "boolean"},
    "extensions": {"type": "object", "additionalProperties": true}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/search-supersession-slice-receipt/v1",
  "title": "Artifact Memory supersession search filter synthetic slice receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_id", "outcome", "operations", "projection", "supersession_filter", "authority_boundary", "limitations"],
  "properties": {
    "schema_id": {"const": "artifact-memory/search-supersession-slice-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^search-supersession-slice-receipt://synthetic/[0-9a-f]{64}$"},
    "outcome": {"type": "string", "enum": ["complete", "failed"]},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "outcome"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "enum": ["complete", "verified", "failed"]}
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_record_set_digest", "record_count"],
      "properties": {
        "source_record_set_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
        "record_count": {"type": "integer", "minimum": 0}
      }
    },
    "supersession_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "default_record_ids", "filtered_record_ids", "literal_filtered_record_ids", "receipt_default_exclude_superseded", "receipt_filtered_exclude_superseded"],
      "properties": {
        "query": {"type": "string", "minLength": 1},
        "default_record_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "filtered_record_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "literal_filtered_record_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "receipt_default_exclude_superseded": {"const": false},
        "receipt_filtered_exclude_superseded": {"const": true}
      }
    },
    "authority_boundary": {"const": "informational-only/no-execution-authority"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/vault-intake-receipt/v1",
  "title": "Artifact Memory vault intake receipt v1",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"outcome": {"enum": ["registered", "duplicate"]}}, "required": ["outcome"]},
      "then": {"properties": {"registration_outcome": {"enum": ["registered", "duplicate"]}, "verification_outcome": {"const": "verified"}, "canonical_records": {"enum": ["created", "duplicate"]}, "diagnostics": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "quarantined"}}, "required": ["outcome"]},
      "then": {"properties": {"registration_outcome": {"const": "not-attempted"}, "verification_outcome": {"const": "not-checked"}, "canonical_records": {"const": "not-created"}, "diagnostics": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"outcome": {"const": "failed"}}, "required": ["outcome"]},
      "then": {"properties": {"diagnostics": {"minItems": 1}}}
    }
  ],
  "required": ["schema_id", "receipt_id", "outcome", "content_ref", "artifact_ref", "artifact_version_ref", "digest", "byte_size", "registration_outcome", "verification_outcome", "canonical_records", "authority_boundary", "diagnostics"],
  "properties": {
    "schema_id": {"const": "artifact-memory/vault-intake-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^vault-intake-receipt://[0-9a-f]{64}$"},
    "outcome": {"enum": ["registered", "duplicate", "quarantined", "failed"]},
    "content_ref": {"type": "string", "pattern": "^content://sha-256/[0-9a-f]{64}$"},
    "artifact_ref": {"type": "string", "pattern": "^artifact://[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+$"},
    "artifact_version_ref": {"type": "string", "pattern": "^artifact-version://[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+/1$"},
    "digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "byte_size": {"type": "integer", "minimum": 0},
    "registration_outcome": {"enum": ["registered", "duplicate", "failed", "not-attempted"]},
    "verification_outcome": {"enum": ["verified", "mismatch", "unreadable", "unsupported", "not-checked"]},
    "canonical_records": {"enum": ["created", "duplicate", "failed", "not-created"]},
    "authority_boundary": {"const": "intake and registration grant no execution, disclosure, mutation, authenticity, trust, or authorization"},
    "diagnostics": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}

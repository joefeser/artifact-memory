{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/coordination-work-receipt/v0",
  "title": "Artifact Memory coordination WorkReceipt v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "record_id", "originId", "receiptId", "taskRef", "writer", "machine", "projectId", "projectName", "headSha", "accessLabelRef", "evidence", "consumedTokensNote", "recordedAt", "authority_boundary"],
  "properties": {
    "schema_id": {"const": "artifact-memory/coordination-work-receipt/v0"},
    "record_id": {"type": "string", "pattern": "^record://coordination/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/receipt/rcpt-[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "originId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "receiptId": {"type": "string", "pattern": "^rcpt-[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "taskRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "revision_digest"],
      "properties": {
        "record_id": {"type": "string", "pattern": "^record://coordination/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/task/task_[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
        "revision_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"}
      }
    },
    "writer": {"type": "string", "minLength": 1},
    "machine": {"type": "string", "minLength": 1},
    "projectId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "projectName": {"type": "string", "minLength": 1},
    "headSha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "accessLabelRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "revision_digest"],
      "properties": {
        "record_id": {"type": "string", "pattern": "^record://coordination/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/label/(?=[A-Za-z0-9._~-]*[A-Za-z0-9_~-]$)[A-Za-z0-9._~-]+$"},
        "revision_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exitCode", "counts", "artifacts"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "exitCode": {"type": "integer"},
          "counts": {
            "type": "object",
            "additionalProperties": false,
            "required": ["passed", "failed", "skipped"],
            "properties": {
              "passed": {"type": "integer", "minimum": 0},
              "failed": {"type": "integer", "minimum": 0},
              "skipped": {"type": "integer", "minimum": 0}
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifactId", "contentDigest", "location", "mediaType", "semanticType"],
              "properties": {
                "artifactId": {"type": "string", "pattern": "^artifact://(?=[A-Za-z0-9._~-]*[A-Za-z0-9_~-])[A-Za-z0-9._~-]+/(?=[A-Za-z0-9._~-]*[A-Za-z0-9_~-])[A-Za-z0-9._~-]+$"},
                "contentDigest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
                "location": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["endpoint_ref", "relative_path"],
                  "properties": {
                    "endpoint_ref": {"type": "string", "pattern": "^endpoint://(?=[A-Za-z0-9._~-]*[A-Za-z0-9_~-])[A-Za-z0-9._~-]+(?:/(?=[A-Za-z0-9._~-]*[A-Za-z0-9_~-])[A-Za-z0-9._~-]+)?$"},
                    "relative_path": {"type": "string", "minLength": 1}
                  }
                },
                "mediaType": {"type": "string", "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"},
                "semanticType": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "consumedTokensNote": {"anyOf": [{"type": "null"}, {"type": "string"}]},
    "recordedAt": {"type": "string", "format": "date-time"},
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^https://[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~/-]+)?$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "required", "value"],
        "properties": {
          "version": {"type": "string", "pattern": "^v[0-9]+$"},
          "required": {"type": "boolean"},
          "value": {"type": "object", "additionalProperties": true}
        }
      }
    },
    "authority_boundary": {"const": "informational only; authority requires independently authenticated WITS enforcement"}
  }
}

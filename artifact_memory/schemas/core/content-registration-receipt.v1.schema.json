{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/content-registration-receipt/v1",
  "title": "Artifact Memory content registration receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_id", "outcome", "content_ref", "artifact_version_ref", "byte_size", "digest", "authority_boundary"],
  "properties": {
    "schema_id": {"const": "artifact-memory/content-registration-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^registration-receipt://[0-9a-f]{64}$"},
    "outcome": {"enum": ["registered", "duplicate", "quarantined", "failed"]},
    "content_ref": {"type": "string", "pattern": "^content://vault/[0-9a-f]{64}$"},
    "artifact_version_ref": {"type": "string", "pattern": "^artifact-version://vault/[0-9a-f]{64}/1$"},
    "byte_size": {"type": "integer", "minimum": 0},
    "digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "media_type": {"type": "string", "minLength": 1},
    "authority_boundary": {"const": "registration does not grant execution, disclosure, or mutation authority"},
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  }
}

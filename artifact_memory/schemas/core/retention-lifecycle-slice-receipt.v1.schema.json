{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/retention-lifecycle-slice-receipt/v1",
  "title": "Artifact Memory retention lifecycle synthetic slice receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_id", "outcome", "policy_id", "scenario_outcomes", "overall_deletion_outcome", "deletion_receipt_refs", "deletion_receipts", "tombstone_refs", "tombstones", "before_record_set_digest", "after_record_set_digest", "before_record_count", "after_record_count", "removed_record_ids", "retained_record_ids", "generated_index_rebuild", "managed_backup_state", "unknown_replica_state", "global_erasure_claim", "destructive_execution_authority", "limitations"],
  "properties": {
    "schema_id": {"const": "artifact-memory/retention-lifecycle-slice-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^retention-lifecycle-receipt://synthetic/[0-9a-f]{64}$"},
    "outcome": {"const": "complete"},
    "policy_id": {"type": "string", "pattern": "^retention-policy://[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+$"},
    "scenario_outcomes": {"type": "object", "additionalProperties": false, "required": ["accidental_ingestion", "redacted_derivative", "deferred_backup_expiry", "owner_approved_deletion"], "properties": {"accidental_ingestion": {"const": "partially-complete"}, "redacted_derivative": {"const": "derivative-replaced"}, "deferred_backup_expiry": {"const": "retained-until-expiry"}, "owner_approved_deletion": {"const": "partially-complete"}}},
    "overall_deletion_outcome": {"const": "partially-complete"},
    "deletion_receipt_refs": {"type": "array", "minItems": 5, "items": {"type": "string", "pattern": "^deletion-receipt://synthetic/[0-9a-f]{64}$"}},
    "deletion_receipts": {"type": "array", "minItems": 5, "items": {"type": "object", "required": ["schema_id", "receipt_id"], "properties": {"schema_id": {"const": "artifact-memory/deletion-receipt/v2"}, "receipt_id": {"type": "string", "pattern": "^deletion-receipt://synthetic/[0-9a-f]{64}$"}}, "additionalProperties": true}},
    "tombstone_refs": {"type": "array", "minItems": 2, "items": {"type": "string", "pattern": "^tombstone://[0-9a-f]{64}$"}},
    "tombstones": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["schema_id", "tombstone_id"], "properties": {"schema_id": {"const": "artifact-memory/tombstone/v2"}, "tombstone_id": {"type": "string", "pattern": "^tombstone://[0-9a-f]{64}$"}}, "additionalProperties": true}},
    "before_record_set_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "after_record_set_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "before_record_count": {"type": "integer", "minimum": 1},
    "after_record_count": {"type": "integer", "minimum": 1},
    "removed_record_ids": {"type": "array", "minItems": 2, "items": {"type": "string", "pattern": "^record://[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+$"}},
    "retained_record_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^record://[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+$"}},
    "generated_index_rebuild": {"const": "deleted-content-absent"},
    "managed_backup_state": {"const": "retained-until-expiry"},
    "unknown_replica_state": {"const": "scope-unknown"},
    "global_erasure_claim": {"const": false},
    "destructive_execution_authority": {"const": "synthetic-fixture-only"},
    "limitations": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/location-observation/v2",
  "title": "Artifact Memory portable location observation v2",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"presence_state": {"const": "present"}}},
      "then": {"properties": {"verification_state": {"enum": ["content-verified", "presence-verified", "unverified", "verification-failed"]}}}
    },
    {
      "if": {"properties": {"presence_state": {"const": "absent"}}},
      "then": {"properties": {"verification_state": {"enum": ["presence-verified", "unverified", "verification-failed"]}}}
    },
    {
      "if": {"properties": {"presence_state": {"const": "unavailable"}}},
      "then": {"properties": {"verification_state": {"enum": ["unverified", "not-applicable"]}}}
    }
  ],
  "required": ["schema_id", "observation_id", "artifact_ref", "content_ref", "endpoint_ref", "relative_path", "presence_state", "verification_state", "observed_at", "discovery_evidence_ref", "authority_boundary"],
  "properties": {
    "schema_id": {"const": "artifact-memory/location-observation/v2"},
    "observation_id": {"type": "string", "pattern": "^location-observation://[A-Za-z0-9._~/-]+$"},
    "artifact_ref": {"type": "string", "pattern": "^artifact://[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+$"},
    "content_ref": {"type": "string", "pattern": "^content://sha-256/[0-9a-f]{64}$"},
    "endpoint_ref": {"type": "string", "pattern": "^endpoint://[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)?$"},
    "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*://)[A-Za-z0-9._~/-]+$"},
    "presence_state": {"type": "string", "enum": ["present", "absent", "unavailable"]},
    "verification_state": {"type": "string", "enum": ["content-verified", "presence-verified", "unverified", "verification-failed", "not-applicable"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "discovery_evidence_ref": {"type": "string", "pattern": "^endpoint-discovery-evidence://[A-Za-z0-9._~/-]+$"},
    "authority_boundary": {"const": "location observation grants no access, mutation, disclosure, or execution authority"}
  }
}

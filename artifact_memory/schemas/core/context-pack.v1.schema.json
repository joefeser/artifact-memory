{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/context-pack/v1",
  "title": "Artifact Memory informational context pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "pack_id", "authority_boundary", "records", "artifact_refs", "external_evidence", "selection_receipt"],
  "properties": {
    "schema_id": {"const": "artifact-memory/context-pack/v1"},
    "pack_id": {"type": "string", "pattern": "^context-pack://[0-9a-f]{64}$"},
    "authority_boundary": {"const": "informational-only; no execution, routing, disclosure, or mutation authority"},
    "records": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["record_id", "revision_digest", "summary", "sensitivity"], "properties": {"record_id": {"type": "string", "minLength": 1}, "revision_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"}, "summary": {"type": "string"}, "labels": {"type": "array", "items": {"type": "string"}}, "sensitivity": {"enum": ["public", "private", "restricted"]}}}},
    "artifact_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "external_evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["provider_id", "provider_schema_id", "provider_record_id", "evidence_packet_ref", "adapter_receipt_digest", "integrity_state", "coverage", "limitations"], "properties": {"provider_id": {"type": "string"}, "provider_schema_id": {"type": "string"}, "provider_record_id": {"type": "string"}, "evidence_packet_ref": {"type": "string"}, "adapter_receipt_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"}, "integrity_state": {"type": "string"}, "rule_id": {"type": "string", "minLength": 1}, "evidence_tier": {"type": "string", "minLength": 1}, "coverage": {"type": "string"}, "coverage_details": {"type": "object", "additionalProperties": false, "required": ["analysis_level", "build_status", "known_gaps"], "properties": {"analysis_level": {"type": "string", "minLength": 1}, "build_status": {"type": "string", "minLength": 1}, "known_gaps": {"type": "array", "items": {"type": "string"}}}}, "limitations": {"type": "array", "items": {"type": "string"}}}}},
    "selection_receipt": {"type": "object", "additionalProperties": false, "required": ["selector_id", "source_record_set_digest", "selected_record_ids", "redacted_record_ids", "max_bytes", "freshness", "disclosure"], "properties": {"selector_id": {"type": "string"}, "source_record_set_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"}, "selected_record_ids": {"type": "array", "items": {"type": "string"}}, "redacted_record_ids": {"type": "array", "items": {"type": "string"}}, "max_bytes": {"type": "integer", "minimum": 1}, "freshness": {"type": "string"}, "disclosure": {"const": "informational-only"}}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/tombstone/v1",
  "title": "Artifact Memory non-sensitive tombstone v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "tombstone_id", "target_ref", "reason", "content_status", "deletion_receipt_ref"],
  "properties": {
    "schema_id": {"const": "artifact-memory/tombstone/v1"},
    "tombstone_id": {"type": "string", "pattern": "^tombstone://[0-9a-f]{64}$"},
    "target_ref": {"type": "string", "minLength": 1},
    "reason": {"enum": ["discarded-draft", "superseded", "redacted-derivative", "owner-approved-deletion", "accidental-ingestion", "retention-expired"]},
    "content_status": {"enum": ["bytes-removed-from-scope", "bytes-retained-under-hold", "bytes-location-unknown", "derivative-replaced"]},
    "superseded_by_ref": {"type": "string", "minLength": 1},
    "deletion_receipt_ref": {"type": "string", "pattern": "^deletion-receipt://[A-Za-z0-9._~-]+/[0-9a-f]{64}$"},
    "extensions": {"type": "object", "additionalProperties": true}
  }
}

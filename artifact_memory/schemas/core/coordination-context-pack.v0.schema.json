{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/coordination-context-pack/v0",
  "title": "Artifact Memory coordination context pack v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "pack_id", "sync_observation", "record_count", "records", "authority_boundary"],
  "properties": {
    "schema_id": {"const": "artifact-memory/coordination-context-pack/v0"},
    "pack_id": {"type": "string", "pattern": "^coordination-context-pack://sha-256/[0-9a-f]{64}$"},
    "sync_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "completed_at", "scope_generation", "access_label_ref", "authorized_pair_count", "authorized_pair_set_digest", "excluded_count", "transport_state", "issuer_state"],
      "properties": {
        "receipt_id": {"type": "string", "pattern": "^coordination-sync-receipt://sha-256/[0-9a-f]{64}$"},
        "completed_at": {"type": "string", "format": "date-time"},
        "scope_generation": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "access_label_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_id", "revision_digest"],
          "properties": {
            "record_id": {"type": "string", "pattern": "^record://coordination/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/label/(?=[A-Za-z0-9._~-]*[A-Za-z0-9_~-]$)[A-Za-z0-9._~-]+$"},
            "revision_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"}
          }
        },
        "authorized_pair_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "authorized_pair_set_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
        "excluded_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "transport_state": {"const": "authenticated"},
        "issuer_state": {"const": "unverified"}
      }
    },
    "record_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "records": {"type": "array", "items": {"type": "object"}},
    "authority_boundary": {"const": "coordination context is informational only and grants no execution, mutation, routing, disclosure, credential, spending, deployment, approval, or merge authority"}
  }
}

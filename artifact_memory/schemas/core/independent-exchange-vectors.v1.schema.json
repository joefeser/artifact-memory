{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/independent-exchange-vectors/v1",
  "title": "Artifact Memory independent exchange vectors v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "audience_ref",
    "expires_at",
    "evaluation_time",
    "artifact_ref",
    "record",
    "optional_extension",
    "required_extension"
  ],
  "properties": {
    "schema_id": {"const": "artifact-memory/independent-exchange-vectors/v1"},
    "audience_ref": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "format": "date-time"},
    "evaluation_time": {"type": "string", "format": "date-time"},
    "artifact_ref": {"type": "string", "pattern": "^artifact://[A-Za-z0-9._~/-]+$"},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "record_id", "record_type", "lifecycle", "meaning", "artifact_refs", "provenance"],
      "properties": {
        "schema_id": {"const": "artifact-memory/knowledge-record/v2"},
        "record_id": {"type": "string", "pattern": "^record://[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+$"},
        "record_type": {"type": "string", "enum": ["note", "decision", "claim", "question", "workstream"]},
        "lifecycle": {"type": "string", "enum": ["draft", "accepted", "sealed", "superseded", "rejected"]},
        "meaning": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary"],
          "properties": {
            "summary": {"type": "string", "minLength": 1},
            "labels": {"type": "array", "items": {"type": "string"}}
          }
        },
        "artifact_refs": {"type": "array", "items": {"type": "string", "pattern": "^artifact://[A-Za-z0-9._~/-]+$"}},
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "source_ref"],
            "properties": {
              "kind": {"type": "string", "enum": ["author", "observation", "import", "derivation"]},
              "source_ref": {"type": "string", "minLength": 1}
            }
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "target_ref"],
            "properties": {
              "type": {"type": "string", "enum": ["related-to", "produced-from", "redacted-from", "supported-by-external-evidence", "supersedes", "disputes", "contradicts"]},
              "target_ref": {"type": "string", "minLength": 1}
            }
          }
        },
        "derivative": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_task_ref", "transformation_ref", "uncertainty"],
          "properties": {
            "source_task_ref": {"type": "string", "minLength": 1},
            "transformation_ref": {"type": "string", "minLength": 1},
            "uncertainty": {"type": "string", "minLength": 1}
          }
        },
        "sensitivity": {"type": "string", "enum": ["public", "private", "restricted"]},
        "extensions": {"type": "object", "additionalProperties": true}
      }
    },
    "optional_extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "declaration"],
      "properties": {
        "identifier": {"type": "string", "pattern": "^https://[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~/-]+)?$"},
        "declaration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "required", "value"],
          "properties": {
            "version": {"type": "string", "pattern": "^v[0-9]+$"},
            "required": {"const": false},
            "value": {"type": "object", "additionalProperties": true}
          }
        }
      }
    },
    "required_extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "declaration"],
      "properties": {
        "identifier": {"type": "string", "pattern": "^https://[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~/-]+)?$"},
        "declaration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "required", "value"],
          "properties": {
            "version": {"type": "string", "pattern": "^v[0-9]+$"},
            "required": {"const": true},
            "value": {"type": "object", "additionalProperties": true}
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/authenticity-conformance-receipt/v1",
  "title": "Artifact Memory synthetic authenticity conformance receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_id", "outcome", "assessment_schema_id", "vector_set_digest", "case_results", "authority_boundary", "limitations"],
  "properties": {
    "schema_id": {"const": "artifact-memory/authenticity-conformance-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^authenticity-conformance-receipt://synthetic/[0-9a-f]{64}$"},
    "outcome": {"const": "complete"},
    "assessment_schema_id": {"const": "artifact-memory/authenticity-receipt/v2"},
    "vector_set_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "case_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case", "assessment_receipt_id", "outcome", "integrity_state", "authenticity_state", "transport_state"],
        "properties": {
          "case": {"type": "string", "minLength": 1},
          "assessment_receipt_id": {"type": "string", "pattern": "^authenticity-receipt://[0-9a-f]{64}$"},
          "outcome": {"enum": ["accepted", "rejected", "unsupported"]},
          "integrity_state": {"enum": ["integrity-verified / issuer-unverified", "integrity-unverified", "integrity-failed"]},
          "authenticity_state": {"enum": ["issuer-unverified", "authenticity-required-unmet", "signed-input-unsupported"]},
          "transport_state": {"enum": ["not-evaluated", "channel-unverified", "channel-authenticated / subject-issuer-unverified"]}
        }
      }
    },
    "authority_boundary": {"const": "assessment grants no execution, disclosure, authorization, or trust"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}

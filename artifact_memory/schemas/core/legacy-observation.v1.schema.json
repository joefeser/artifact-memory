{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/legacy-observation/v1",
  "title": "Artifact Memory historical lineage observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "source_ref", "read_only", "historical_fields", "artifact_identity", "content_identity", "mutation", "limitations"],
  "properties": {
    "schema_id": {"const": "artifact-memory/legacy-observation/v1"},
    "source_ref": {"type": "string", "minLength": 1},
    "read_only": {"const": true},
    "historical_fields": {"type": "object", "additionalProperties": false, "required": ["path_observed", "byte_size_observed", "created_time_observed", "modified_time_observed", "legacy_hash"], "properties": {"path_observed": {"type": "string"}, "byte_size_observed": {"type": "integer", "minimum": 0}, "created_time_observed": {"type": "string"}, "modified_time_observed": {"type": "string"}, "legacy_hash": {"type": "object", "additionalProperties": false, "required": ["algorithm", "state", "value"], "properties": {"algorithm": {"const": "sha-1"}, "state": {"enum": ["none-recorded", "sha-1-observed-not-upgraded"]}, "value": {"type": "string", "minLength": 1}}}}},
    "artifact_identity": {"const": "not-established"},
    "content_identity": {"const": "not-established"},
    "mutation": {"const": "none"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}

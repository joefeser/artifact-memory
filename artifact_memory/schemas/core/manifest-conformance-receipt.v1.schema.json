{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/manifest-conformance-receipt/v1",
  "title": "Artifact Memory portable manifest conformance receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_id", "outcome", "synthetic", "vector_set_digest", "positive_case_count", "platforms", "platform_tree_digests", "positive_cases", "outcomes", "negative_cases", "container_digest", "extracted_tree_digest", "container_tree_distinct", "claims", "limitations"],
  "properties": {
    "schema_id": {"const": "artifact-memory/manifest-conformance-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^manifest-conformance-receipt://[0-9a-f]{64}$"},
    "outcome": {"const": "complete"},
    "synthetic": {"const": true},
    "vector_set_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "positive_case_count": {"type": "integer", "minimum": 2},
    "platforms": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"enum": ["linux", "macos", "windows"]}},
    "platform_tree_digests": {"type": "object", "additionalProperties": false, "required": ["linux", "macos", "windows"], "properties": {"linux": {"type": "array", "minItems": 2, "items": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"}}, "macos": {"type": "array", "minItems": 2, "items": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"}}, "windows": {"type": "array", "minItems": 2, "items": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"}}}},
    "positive_cases": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "outcome", "entry_count", "tree_digest"], "properties": {"case_id": {"type": "string", "minLength": 1}, "outcome": {"const": "equivalent"}, "entry_count": {"type": "integer", "minimum": 1}, "tree_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"}}}},
    "outcomes": {"type": "object", "additionalProperties": false, "required": ["collision", "unsupported", "partial"], "properties": {"collision": {"type": "integer", "minimum": 1}, "unsupported": {"type": "integer", "minimum": 1}, "partial": {"type": "integer", "minimum": 1}}},
    "negative_cases": {"type": "array", "minItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "outcome", "manifest_completeness", "diagnostic_code"], "properties": {"case_id": {"type": "string", "minLength": 1}, "outcome": {"enum": ["collision", "unsupported", "partial"]}, "manifest_completeness": {"const": "partial"}, "diagnostic_code": {"enum": ["collision", "unsupported", "unreadable"]}}}},
    "container_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "extracted_tree_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "container_tree_distinct": {"const": true},
    "claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

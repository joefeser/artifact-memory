{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/vault-intake-vector/v1",
  "title": "Artifact Memory vault intake conformance vector v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "payload", "intake"],
  "properties": {
    "schema_id": {"const": "artifact-memory/vault-intake-vector/v1"},
    "payload": {"const": "payload.txt"},
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_kind", "title", "created_at", "source_ref", "media_type"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^artifact://[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+$"},
        "artifact_kind": {"enum": ["document", "source-tree", "package", "evidence", "projection", "media", "other"]},
        "title": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "source_ref": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*://[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*$", "not": {"pattern": "^(?:file|ftp|ftps|http|https|nfs|sftp|smb|ssh)://.*$"}},
        "media_type": {"type": "string", "minLength": 1}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/conformance-expected-results/v1",
  "title": "Artifact Memory runner-neutral conformance expected results v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "fixture_set_id", "results"],
  "properties": {
    "schema_id": {"const": "artifact-memory/conformance-expected-results/v1"},
    "fixture_set_id": {"type": "string", "pattern": "^fixture-set://synthetic/[A-Za-z0-9._~-]+$"},
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result_id", "case_id", "class", "outcome", "diagnostic_codes", "assertions"],
        "properties": {
          "result_id": {"type": "string", "pattern": "^fixture-result://synthetic/[A-Za-z0-9._~-]+$"},
          "case_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "class": {"enum": ["valid", "invalid", "equivalent", "collision", "unsupported"]},
          "outcome": {"enum": ["accepted", "rejected", "equivalent", "collision", "unsupported"]},
          "diagnostic_codes": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pointer", "operator", "value"],
              "properties": {
                "pointer": {"type": "string", "pattern": "^/.*$"},
                "operator": {"const": "equals"},
                "value": {}
              }
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/vault-intake-conformance-receipt/v1",
  "title": "Artifact Memory vault intake conformance receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_id", "synthetic", "content_ref", "artifact_ref", "artifact_version_ref", "stages", "payload_digest", "authority_boundary", "limitations"],
  "properties": {
    "schema_id": {"const": "artifact-memory/vault-intake-conformance-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^vault-intake-conformance-receipt://[0-9a-f]{64}$"},
    "synthetic": {"const": true},
    "content_ref": {"type": "string", "pattern": "^content://sha-256/[0-9a-f]{64}$"},
    "artifact_ref": {"type": "string", "pattern": "^artifact://[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+$"},
    "artifact_version_ref": {"type": "string", "pattern": "^artifact-version://[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+/1$"},
    "stages": {
      "const": [
        {"name": "hash-register-verify", "outcome": "registered"},
        {"name": "canonical-artifact-version-records", "outcome": "created"},
        {"name": "duplicate-replay", "outcome": "duplicate"},
        {"name": "digest-mismatch-quarantine", "outcome": "quarantined"}
      ]
    },
    "payload_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "authority_boundary": {"const": "intake and registration grant no execution, disclosure, mutation, authenticity, trust, or authorization"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

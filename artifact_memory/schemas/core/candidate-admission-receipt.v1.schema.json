{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/candidate-admission-receipt/v1",
  "title": "Artifact Memory candidate admission receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_id", "candidate_id", "candidate_revision_digest", "source_record_refs", "outcome", "decision_ref", "result_record_ref", "diagnostics", "authority_boundary"],
  "properties": {
    "schema_id": {"const": "artifact-memory/candidate-admission-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^candidate-admission-receipt://[0-9a-f]{64}$"},
    "candidate_id": {"type": "string", "pattern": "^candidate://[A-Za-z0-9._~-]+/[0-9a-f]{64}$"},
    "candidate_revision_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "source_record_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["record_id", "revision_digest"], "properties": {"record_id": {"type": "string"}, "revision_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"}}}},
    "outcome": {"enum": ["accepted", "rejected", "quarantined", "duplicate", "stale", "unsupported", "conflict"]},
    "decision_ref": {"type": "string", "minLength": 1},
    "result_record_ref": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["record_id", "revision_digest"], "properties": {"record_id": {"type": "string", "pattern": "^record://[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+$"}, "revision_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"}}}]},
    "diagnostics": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}}},
    "authority_boundary": {"const": "candidate admission grants no execution, disclosure, routing, mutation, merge, deployment, spending, credential, declassification, or approval authority"}
  },
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "accepted"}}, "required": ["outcome"]}, "then": {"required": ["result_record_ref"], "properties": {"result_record_ref": {"type": "object"}, "diagnostics": {"maxItems": 0}}}},
    {"if": {"properties": {"outcome": {"enum": ["rejected", "quarantined", "duplicate", "stale", "unsupported", "conflict"]}}, "required": ["outcome"]}, "then": {"properties": {"result_record_ref": {"const": null}, "diagnostics": {"minItems": 1}}}}
  ]
}

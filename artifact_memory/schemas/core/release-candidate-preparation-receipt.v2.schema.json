{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/release-candidate-preparation-receipt/v2",
  "title": "Artifact Memory release candidate preparation receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_id", "outcome", "release_id", "status", "source_commit", "tree_digest", "release_manifest_digest", "tag_message_trailer", "source_archive_digest", "source_archive_byte_size", "release_notes_digest", "release_notes_byte_size", "checksum_manifest_digest", "schema_inventory_count", "schema_inventory_digest", "package_version", "tag", "public_key_fingerprint", "key_generation", "signature_verification_state", "publication_state", "claims", "authority_boundary", "limitations"],
  "properties": {
    "schema_id": {"const": "artifact-memory/release-candidate-preparation-receipt/v2"},
    "receipt_id": {"type": "string", "pattern": "^release-candidate-preparation-receipt://[0-9a-f]{64}$"},
    "outcome": {"const": "pass"},
    "release_id": {"type": "string", "pattern": "^artifact-memory/v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "release-candidate"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "release_manifest_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "tag_message_trailer": {"type": "string", "pattern": "^Artifact-Memory-Manifest-SHA256: sha-256:[0-9a-f]{64}$"},
    "source_archive_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "source_archive_byte_size": {"type": "integer", "minimum": 1},
    "release_notes_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "release_notes_byte_size": {"type": "integer", "minimum": 1},
    "checksum_manifest_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "schema_inventory_count": {"type": "integer", "minimum": 1},
    "schema_inventory_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "package_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "public_key_fingerprint": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"},
    "key_generation": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "signature_verification_state": {"const": "pending-owner-signature"},
    "publication_state": {"const": "not-authorized"},
    "claims": {
      "type": "array",
      "const": [
        "source tree, source archive, release notes, checksum manifest, release manifest, schema inventory, and package version reproduce from the named commit",
        "the required annotated-tag trailer binds the exact prepared release manifest bytes",
        "owner signature verification and publication remain explicitly absent"
      ]
    },
    "authority_boundary": {"const": "release preparation grants no signing, tag, publication, visibility, or deployment authority"},
    "limitations": {
      "type": "array",
      "const": [
        "the release manifest remains explicitly pending until the owner-signed annotated tag is independently verified",
        "the owner must independently verify the public fingerprint and sign the exact tag message trailer",
        "publication requires separate owner authorization after signed-candidate verification"
      ]
    }
  }
}

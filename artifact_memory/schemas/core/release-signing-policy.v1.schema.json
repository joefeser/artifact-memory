{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/release-signing-policy/v1",
  "title": "Artifact Memory release signing policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "key_role", "algorithm", "owner_control", "private_material_boundary", "public_fingerprint_state", "verification", "rotation", "revocation", "recovery", "attestation"],
  "properties": {
    "schema_id": {"const": "artifact-memory/release-signing-policy/v1"},
    "key_role": {"const": "artifact-memory-release-signing"},
    "algorithm": {"const": "ssh-ed25519"},
    "owner_control": {"const": "owner-exclusive"},
    "private_material_boundary": {"const": "never-received-retained-or-invoked-by-agent"},
    "public_fingerprint_state": {"enum": ["owner-to-fill", "recorded"]},
    "verification": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "rotation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "revocation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "recovery": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "attestation": {"const": "keyless-attestation-deferred-until-public-workflow"}
  }
}

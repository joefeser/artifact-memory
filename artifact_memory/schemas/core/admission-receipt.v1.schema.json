{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/admission-receipt/v1",
  "title": "Artifact Memory exchange admission receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_id", "envelope_ref", "outcome", "accepted_record_ids", "diagnostics", "authority_boundary"],
  "properties": {
    "schema_id": {"const": "artifact-memory/admission-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^admission-receipt://[0-9a-f]{64}$"},
    "envelope_ref": {"type": "string", "pattern": "^exchange://[0-9a-f]{64}$"},
    "outcome": {"enum": ["admitted", "rejected", "quarantined", "duplicate", "unsupported", "partially-resolved"]},
    "accepted_record_ids": {"type": "array", "items": {"type": "string"}},
    "diagnostics": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}},
    "authority_boundary": {"const": "knowledge exchange grants no execution, disclosure, routing, spending, credential, deployment, merge, or mutation authority"},
    "extensions": {"type": "object", "additionalProperties": true}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/coordination-access-label/v0",
  "title": "Artifact Memory coordination AccessLabel v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "record_id", "originId", "labelId", "credentialHint", "projectNames", "may", "mayNot", "notes", "authority_boundary"],
  "properties": {
    "schema_id": {"const": "artifact-memory/coordination-access-label/v0"},
    "record_id": {"type": "string", "pattern": "^record://coordination/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/label/(?=[A-Za-z0-9._~-]*[A-Za-z0-9_~-]$)[A-Za-z0-9._~-]+$"},
    "originId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "labelId": {"type": "string", "pattern": "^(?=[A-Za-z0-9._~-]*[A-Za-z0-9_~-]$)[A-Za-z0-9._~-]+$"},
    "credentialHint": {"type": "string", "minLength": 1},
    "projectNames": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectId", "projectName"],
        "properties": {
          "projectId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
          "projectName": {"type": "string", "minLength": 1}
        }
      }
    },
    "may": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimProjects", "postReceipts", "readProjects", "syncTaskPackets", "syncWorkReceipts"],
      "properties": {
        "claimProjects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}},
        "postReceipts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}},
        "readProjects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}},
        "syncTaskPackets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}},
        "syncWorkReceipts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}}
      }
    },
    "mayNot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readProjects"],
      "properties": {
        "readProjects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}}
      }
    },
    "notes": {"type": "string"},
    "extensions": {
      "type": "object",
      "propertyNames": {"pattern": "^https://[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~/-]+)?$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "required", "value"],
        "properties": {
          "version": {"type": "string", "pattern": "^v[0-9]+$"},
          "required": {"type": "boolean"},
          "value": {"type": "object", "additionalProperties": true}
        }
      }
    },
    "authority_boundary": {"const": "informational only; authority requires independently authenticated WITS enforcement"}
  }
}

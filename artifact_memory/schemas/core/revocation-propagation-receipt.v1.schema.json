{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/revocation-propagation-receipt/v1",
  "title": "Artifact Memory revocation propagation receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_id", "envelope_ref", "outcome", "recipient_receipt_refs", "acknowledged_recipient_refs", "unresolved_recipient_refs", "audit_state", "authority_boundary"],
  "properties": {
    "schema_id": {"const": "artifact-memory/revocation-propagation-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^revocation-propagation-receipt://[0-9a-f]{64}$"},
    "envelope_ref": {"type": "string", "pattern": "^revocation://[0-9a-f]{64}$"},
    "outcome": {"enum": ["acknowledged", "partially-complete"]},
    "recipient_receipt_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^revocation-receipt://[0-9a-f]{64}$"}},
    "acknowledged_recipient_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unresolved_recipient_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "audit_state": {"const": "immutable-receipt-retained"},
    "authority_boundary": {"const": "revocation propagation grants no execution, disclosure, routing, mutation, or erasure authority"}
  }
}

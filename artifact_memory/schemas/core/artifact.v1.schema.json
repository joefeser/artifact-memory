{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/artifact/v1",
  "title": "Artifact Memory artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "artifact_id", "artifact_kind", "title", "created_at", "authority_boundary"],
  "properties": {
    "schema_id": {"const": "artifact-memory/artifact/v1"},
    "artifact_id": {"type": "string", "pattern": "^artifact://[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+$"},
    "artifact_kind": {"enum": ["document", "source-tree", "package", "evidence", "projection", "media", "other"]},
    "title": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "authority_boundary": {"const": "artifact identity grants no content access, execution, disclosure, mutation, authenticity, trust, or authorization"},
    "extensions": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["version", "required", "value"], "properties": {"version": {"type": "string", "pattern": "^v[0-9]+$"}, "required": {"type": "boolean"}, "value": {"type": "object", "additionalProperties": true}}}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/release-preparation-receipt/v2",
  "title": "Artifact Memory unsigned release preview preparation receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_id", "outcome", "release_id", "status", "source_commit", "tree_digest", "source_archive_digest", "source_archive_byte_size", "checksum_manifest_digest", "schema_inventory_count", "schema_inventory_digest", "package_version", "signature_state", "publication_state", "claims", "authority_boundary", "limitations"],
  "properties": {
    "schema_id": {"const": "artifact-memory/release-preparation-receipt/v2"},
    "receipt_id": {"type": "string", "pattern": "^release-preparation-receipt://[0-9a-f]{64}$"},
    "outcome": {"const": "pass"},
    "release_id": {"type": "string", "pattern": "^artifact-memory/v[0-9]+\\.[0-9]+\\.[0-9]+-preview$"},
    "status": {"const": "preview"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tree_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "source_archive_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "source_archive_byte_size": {"type": "integer", "minimum": 1},
    "checksum_manifest_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "schema_inventory_count": {"type": "integer", "minimum": 1},
    "schema_inventory_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "package_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:\\.dev[0-9]+)?$"},
    "signature_state": {"const": "unsigned-preview"},
    "publication_state": {"const": "not-authorized"},
    "claims": {
      "type": "array",
      "const": [
        "source tree, source archive, checksum manifest, schema inventory, and package version reproduce from the named commit",
        "preview signature and publication remain explicitly absent",
        "protocol, schema, CLI, adapter, and fixture surfaces carry separate version policies"
      ]
    },
    "authority_boundary": {"const": "release preparation grants no signing, tag, publication, visibility, or deployment authority"},
    "limitations": {
      "type": "array",
      "const": [
        "preview evidence is unsigned and is not a release",
        "anonymous public-clone verification and push-rule restoration require later owner-authorized publication"
      ]
    }
  }
}

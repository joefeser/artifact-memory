{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/search-ranking-slice-receipt/v1",
  "title": "Artifact Memory conditional bm25 synthetic slice receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_id", "outcome", "operations", "projection", "ranked_search", "authority_boundary", "limitations"],
  "properties": {
    "schema_id": {"const": "artifact-memory/search-ranking-slice-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^search-ranking-slice-receipt://synthetic/[0-9a-f]{64}$"},
    "outcome": {"type": "string", "enum": ["complete", "failed"]},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "outcome"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "enum": ["complete", "verified", "failed"]}
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paired_source_record_set_digest", "full_source_record_set_digest", "paired_record_count", "full_record_count"],
      "properties": {
        "paired_source_record_set_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
        "full_source_record_set_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
        "paired_record_count": {"type": "integer", "minimum": 0},
        "full_record_count": {"type": "integer", "minimum": 0}
      }
    },
    "ranked_search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "unranked_record_ids", "paired_ranked_record_ids", "full_ranked_record_ids", "receipt_result_order", "default_receipt_omits_result_order"],
      "properties": {
        "query": {"type": "string", "minLength": 1},
        "unranked_record_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "paired_ranked_record_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "full_ranked_record_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "receipt_result_order": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ranking", "tiebreak", "authoritative", "corpus_dependent"],
          "properties": {
            "ranking": {"const": "bm25"},
            "tiebreak": {"const": "record-id"},
            "authoritative": {"const": false},
            "corpus_dependent": {"const": true}
          }
        },
        "default_receipt_omits_result_order": {"const": true}
      }
    },
    "authority_boundary": {"const": "informational-only/no-execution-authority"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

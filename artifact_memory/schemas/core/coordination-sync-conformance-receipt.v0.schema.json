{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/coordination-sync-conformance-receipt/v0",
  "title": "Artifact Memory coordination sync conformance receipt v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "receipt_id",
    "outcome",
    "pair_set_vector_count",
    "typed_outcome_count",
    "task_chain_vector_count",
    "record_bound_egress_vector_count",
    "project_provenance_vector_count",
    "label_rotation_vector_count",
    "pagination_page_count",
    "replica_count",
    "authorized_union_pair_count",
    "second_replica_pair_count",
    "second_round",
    "pending_outcome_recovery",
    "equal_time_scope_replay",
    "authority_boundary"
  ],
  "properties": {
    "schema_id": {"const": "artifact-memory/coordination-sync-conformance-receipt/v0"},
    "receipt_id": {"type": "string", "pattern": "^coordination-sync-conformance-receipt://sha-256/[0-9a-f]{64}$"},
    "outcome": {"const": "passed"},
    "pair_set_vector_count": {"type": "integer", "minimum": 1},
    "typed_outcome_count": {"type": "integer", "minimum": 1},
    "task_chain_vector_count": {"type": "integer", "minimum": 1},
    "record_bound_egress_vector_count": {"type": "integer", "minimum": 1},
    "project_provenance_vector_count": {"type": "integer", "minimum": 1},
    "label_rotation_vector_count": {"type": "integer", "minimum": 1},
    "pagination_page_count": {"type": "integer", "minimum": 1},
    "replica_count": {"type": "integer", "minimum": 2},
    "authorized_union_pair_count": {"type": "integer", "minimum": 1},
    "second_replica_pair_count": {"type": "integer", "minimum": 1},
    "second_round": {"const": "byte-identical-no-op"},
    "pending_outcome_recovery": {"const": "protected-and-consumed"},
    "equal_time_scope_replay": {"const": "rejected"},
    "authority_boundary": {"const": "synthetic sync proof grants no execution, disclosure, authorization, or trust"}
  }
}

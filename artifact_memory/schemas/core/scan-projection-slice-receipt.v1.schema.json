{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/scan-projection-slice-receipt/v1",
  "title": "Artifact Memory scan and projection synthetic slice receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_id", "outcome", "operations", "before_manifest_ref", "after_manifest_ref", "diff", "projection", "authority_boundary", "limitations"],
  "properties": {
    "schema_id": {"const": "artifact-memory/scan-projection-slice-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^scan-projection-receipt://synthetic/[0-9a-f]{64}$"},
    "outcome": {"type": "string", "enum": ["complete", "failed"]},
    "operations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "outcome"], "properties": {"name": {"type": "string", "minLength": 1}, "outcome": {"type": "string", "enum": ["complete", "verified", "failed"]}}}},
    "before_manifest_ref": {"type": "string", "pattern": "^manifest://[0-9a-f]{64}$"},
    "after_manifest_ref": {"type": "string", "pattern": "^manifest://[0-9a-f]{64}$"},
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "added", "removed", "changed", "moved_candidates"],
      "properties": {
        "outcome": {"const": "complete"},
        "added": {"type": "array", "items": {"type": "string"}},
        "removed": {"type": "array", "items": {"type": "string"}},
        "changed": {"type": "array", "items": {"type": "string"}},
        "moved_candidates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to", "content_digest"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}, "content_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"}}}}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_record_set_digest", "record_count", "order_independent", "deleted_before_rebuild", "logical_rebuild_equivalent", "full_text_record_ids", "relationships", "provenance_record_ids"],
      "properties": {
        "source_record_set_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
        "record_count": {"type": "integer", "minimum": 0},
        "order_independent": {"const": true},
        "deleted_before_rebuild": {"const": true},
        "logical_rebuild_equivalent": {"const": true},
        "full_text_record_ids": {"type": "array", "items": {"type": "string"}},
        "relationships": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["type", "target_ref"], "properties": {"type": {"type": "string"}, "target_ref": {"type": "string"}}}},
        "provenance_record_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "authority_boundary": {"const": "informational-only/no-execution-authority"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

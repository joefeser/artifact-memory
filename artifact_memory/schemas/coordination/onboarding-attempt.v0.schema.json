{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/coordination/onboarding-attempt/v0",
  "title": "Artifact Memory local coordination onboarding attempt v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "attempt_id",
    "project",
    "repo_identity_state",
    "vault_state",
    "hub_id",
    "access_label_ref",
    "scope_generation",
    "completed_at",
    "pair_count_before",
    "authority_boundary"
  ],
  "properties": {
    "schema_id": {
      "const": "artifact-memory/local-coordination-onboarding-attempt/v0"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^coordination-onboarding-attempt://sha-256/[0-9a-f]{64}$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "project_name"],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "project_name": {"type": "string", "minLength": 1}
      }
    },
    "repo_identity_state": {
      "enum": ["created-pending-commit", "existing-pending-commit", "verified-committed"]
    },
    "vault_state": {"enum": ["created", "linked"]},
    "hub_id": {"type": "string", "pattern": "^coordination-hub://\\S+$"},
    "access_label_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "revision_digest"],
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^record://coordination/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/label/[^/]+$"
        },
        "revision_digest": {
          "type": "string",
          "pattern": "^sha-256:[0-9a-f]{64}$"
        }
      }
    },
    "scope_generation": {"type": "integer", "minimum": 0},
    "completed_at": {"type": "string", "format": "date-time"},
    "pair_count_before": {"type": "integer", "minimum": 0},
    "authority_boundary": {
      "const": "onboarding artifacts are informational only and grant no execution, mutation, routing, disclosure, credential, spending, deployment, approval, or merge authority"
    }
  }
}

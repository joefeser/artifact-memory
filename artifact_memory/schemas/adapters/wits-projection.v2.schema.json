{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/adapters/wits-projection/v2",
  "title": "Artifact Memory WITS projection reference v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "projection_id", "source_record_refs", "external_evidence_refs", "projection_kind", "wits_projection_ref", "wits_projection_schema_ref", "projection_digest", "request_digest", "provider_contract", "authority_boundary"],
  "properties": {
    "schema_id": {"const": "artifact-memory/wits-projection/v2"},
    "projection_id": {"type": "string", "pattern": "^wits-binding://[0-9a-f]{64}$"},
    "source_record_refs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["record_id", "revision_digest"], "properties": {"record_id": {"type": "string"}, "revision_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"}}}},
    "external_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "projection_kind": {"enum": ["owner-meaning", "decision", "readiness", "ambiguity"]},
    "wits_projection_ref": {"type": "string", "pattern": "^wits-projection://[A-Za-z0-9._~/-]+$"},
    "wits_projection_schema_ref": {"type": "string", "pattern": "^wits-contract://[A-Za-z0-9._~/-]+$"},
    "projection_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "request_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "provider_contract": {"type": "object", "additionalProperties": false, "required": ["repository", "commit", "license", "change_date", "change_license", "contract_refs"], "properties": {"repository": {"const": "joefeser/what-is-the-spec"}, "commit": {"const": "d675ba6d632dc03826f27940014d4cd672f7d910"}, "license": {"const": "BSL-1.1"}, "change_date": {"const": "2030-01-01"}, "change_license": {"const": "Apache-2.0"}, "contract_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "extensions": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["version", "required", "value"], "properties": {"version": {"type": "string", "pattern": "^v[0-9]+$"}, "required": {"const": false}, "value": {"type": "object", "additionalProperties": true}}}},
    "authority_boundary": {"const": "informational projection only; no HACP task, route, continuation, or execution authority"}
  }
}

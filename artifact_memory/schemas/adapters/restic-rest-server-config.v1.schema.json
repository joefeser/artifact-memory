{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/adapters/restic-rest-server-config/v1",
  "title": "Artifact Memory append-only rest-server owner configuration template v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "endpoint_ref", "transport", "mode", "tailnet_boundary", "address_state", "account_state", "repository_state", "service_state", "secret_state", "storage_boundary", "recovery_boundary", "remote_write_state"],
  "properties": {
    "schema_id": {"const": "artifact-memory/restic-rest-server-config/v1"},
    "endpoint_ref": {"const": "endpoint://joe-home-proxmox-vault-1"},
    "transport": {"const": "restic-rest-server"},
    "mode": {"const": "append-only"},
    "tailnet_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "guest_only", "public_inbound", "approved_clients_only"],
      "properties": {
        "required": {"const": true},
        "guest_only": {"const": true},
        "public_inbound": {"const": false},
        "approved_clients_only": {"const": true}
      }
    },
    "address_state": {"enum": ["owner-to-fill", "configured"]},
    "account_state": {"enum": ["owner-to-fill", "configured"]},
    "repository_state": {"enum": ["owner-to-fill", "configured"]},
    "service_state": {"enum": ["owner-to-fill", "configured"]},
    "secret_state": {"const": "external-not-recorded"},
    "storage_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "zfs_snapshot_schedule_state", "snapshot_control"],
      "properties": {
        "backend": {"const": "zfs-backed"},
        "zfs_snapshot_schedule_state": {"enum": ["owner-to-fill", "configured"]},
        "snapshot_control": {"const": "server-side-separate-from-backup-client"}
      }
    },
    "recovery_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_state", "alternate_access", "tailscale_exclusive"],
      "properties": {
        "material_state": {"const": "owner-held-external"},
        "alternate_access": {"const": "console-or-local"},
        "tailscale_exclusive": {"const": false}
      }
    },
    "remote_write_state": {"enum": ["not-authorized", "authorized"]}
  },
  "allOf": [
    {
      "if": {"properties": {"remote_write_state": {"const": "authorized"}}, "required": ["remote_write_state"]},
      "then": {
        "properties": {
          "address_state": {"const": "configured"},
          "account_state": {"const": "configured"},
          "repository_state": {"const": "configured"},
          "service_state": {"const": "configured"},
          "storage_boundary": {"properties": {"zfs_snapshot_schedule_state": {"const": "configured"}}}
        }
      }
    }
  ]
}

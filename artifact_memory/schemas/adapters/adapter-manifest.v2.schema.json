{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/adapters/adapter-manifest/v2",
  "title": "Artifact Memory adapter manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "adapter_id", "adapter_version", "supported_contract_versions", "capabilities", "input_schema_refs", "output_schema_refs", "determinism", "record_contents_authorize_execution"],
  "properties": {
    "schema_id": {"const": "artifact-memory/adapter-manifest/v2"},
    "adapter_id": {"type": "string", "pattern": "^adapter://[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+$"},
    "adapter_version": {"type": "string", "pattern": "^v[0-9]+(?:\\.[0-9]+)*$"},
    "supported_contract_versions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "capabilities": {"type": "object", "additionalProperties": false, "required": ["filesystem", "network", "credentials", "mutation", "read_capabilities"], "properties": {"filesystem": {"enum": ["none", "read", "read-write"]}, "network": {"enum": ["none", "read", "read-write"]}, "credentials": {"enum": ["none", "declared-external"]}, "mutation": {"enum": ["none", "declared-external"]}, "read_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "input_schema_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "output_schema_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "determinism": {"enum": ["deterministic", "observation-metadata-nondeterministic"]},
    "record_contents_authorize_execution": {"const": false},
    "extensions": {"type": "object", "propertyNames": {"pattern": "^https://[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~/-]+)?$"}, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["version", "required", "value"], "properties": {"version": {"type": "string", "pattern": "^v[0-9]+$"}, "required": {"type": "boolean"}, "value": {"type": "object", "additionalProperties": true}}}}
  }
}

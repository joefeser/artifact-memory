{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/adapters/tracemap-vertical-slice-receipt/v1",
  "title": "Artifact Memory TraceMap vertical-slice receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_id", "outcome", "synthetic", "stages", "source_version_ref", "source_manifest_ref", "source_tree_digest", "source_git_commit", "provider_contract_anchor", "provider_tool_source_commit", "selected_provider_record_ids", "binding_id", "evidence_packet_ref", "integrity_state", "claim_record_id", "projection_source_digest", "context_pack_id", "backup_outcome", "restore_outcome", "authority_boundary", "limitations"],
  "properties": {
    "schema_id": {"const": "artifact-memory/tracemap-vertical-slice-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^vertical-slice-receipt://[0-9a-f]{64}$"},
    "outcome": {"const": "complete"},
    "synthetic": {"const": true},
    "stages": {"type": "array", "minItems": 10, "items": {"type": "object", "additionalProperties": false, "required": ["name", "outcome"], "properties": {"name": {"type": "string", "minLength": 1}, "outcome": {"const": "complete"}}}},
    "source_version_ref": {"type": "string", "pattern": "^artifact-version://[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+/[0-9]+$"},
    "source_manifest_ref": {"type": "string", "pattern": "^manifest://[0-9a-f]{64}$"},
    "source_tree_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "source_git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "provider_contract_anchor": {"const": "9a252f12f781ae2a0aab52b5faa53601440a2a3b"},
    "provider_tool_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "selected_provider_record_ids": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "binding_id": {"type": "string", "pattern": "^binding://tracemap/[0-9a-f]{64}$"},
    "evidence_packet_ref": {"type": "string", "pattern": "^artifact-version://tracemap/evidence/[0-9a-f]{64}/1$"},
    "integrity_state": {"const": "integrity-verified / issuer-unverified"},
    "claim_record_id": {"type": "string", "pattern": "^record://[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+$"},
    "projection_source_digest": {"type": "string", "pattern": "^sha-256:[0-9a-f]{64}$"},
    "context_pack_id": {"type": "string", "pattern": "^context-pack://[0-9a-f]{64}$"},
    "backup_outcome": {"const": "created"},
    "restore_outcome": {"const": "restored"},
    "authority_boundary": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}

{
  "schema_id": "artifact-memory/adapter-manifest/v1",
  "adapter_id": "adapter://artifact-memory/tracemap-evidence",
  "adapter_version": "v1.0",
  "supported_contract_versions": ["artifact-memory/tracemap-evidence-binding/v1", "https://tracemap.tools/contracts/scan-manifest.v1.schema.json", "https://tracemap.tools/contracts/code-fact.v1.schema.json"],
  "capabilities": {"filesystem": "read", "network": "none", "credentials": "none", "mutation": "none", "read_capabilities": ["trace-map-local-output"]},
  "input_schema_refs": ["artifact-memory/artifact-version/v1"],
  "output_schema_refs": ["artifact-memory/tracemap-evidence-binding/v1", "artifact-memory/adapter-receipt/v1"],
  "determinism": "deterministic",
  "record_contents_authorize_execution": false,
  "extensions": {
    "https://artifact-memory.dev/extensions/compatibility": {
      "version": "v1",
      "required": false,
      "value": {
        "legacy_binding_read": "Previously valid v1 bindings remain readable without the additive provider identity and selected-provider-record detail fields; the current writer emits those fields.",
        "opaque_packet_bytes": "report.md and logs/analyzer.log are availability-checked and content-addressed as opaque bytes; the adapter does not add an encoding requirement."
      }
    }
  }
}

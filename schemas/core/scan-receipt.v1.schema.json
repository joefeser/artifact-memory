{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/scan-receipt/v1",
  "title": "Artifact Memory scan receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "receipt_id", "policy_ref", "outcome", "accounted_entry_count", "diagnostics", "manifest_ref"],
  "properties": {
    "schema_id": {"const": "artifact-memory/scan-receipt/v1"},
    "receipt_id": {"type": "string", "pattern": "^scan-receipt://[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+$"},
    "policy_ref": {"type": "string", "pattern": "^scan-policy://[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+$"},
    "manifest_ref": {"type": "string", "pattern": "^manifest://[0-9a-f]{64}$"},
    "outcome": {"type": "string", "enum": ["complete", "partial", "failed", "cancelled"]},
    "accounted_entry_count": {"type": "integer", "minimum": 0},
    "diagnostics": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string", "enum": ["unreadable", "excluded", "unsupported", "collision", "resolver-unavailable", "resource-limit", "cancelled"]}, "message": {"type": "string", "minLength": 1}}}},
    "extensions": {"type": "object", "additionalProperties": true}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artifact-memory.dev/schemas/core/artifact-version/v1",
  "title": "Artifact Memory artifact version v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "artifact_id", "version_id", "content_refs", "lifecycle"],
  "properties": {
    "schema_id": {"const": "artifact-memory/artifact-version/v1"},
    "artifact_id": {"type": "string", "pattern": "^artifact://[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+$"},
    "version_id": {"type": "string", "pattern": "^artifact-version://[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+/[0-9]+$"},
    "content_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^content://[A-Za-z0-9._~-]+/[A-Za-z0-9._~-]+$"}},
    "lifecycle": {"type": "string", "enum": ["draft", "accepted", "sealed", "superseded", "rejected"]},
    "extensions": {"type": "object", "additionalProperties": true}
  }
}
